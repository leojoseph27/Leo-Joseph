# =============================================================================
# Environment variables for Leo404 + Gemini integration
# =============================================================================
# Copy this file to `.env` for local development. NEVER commit `.env`.
#
# Deployment platforms:
#   - Vercel:          add GOOGLE_API_KEY under Project Settings -> Environment Variables
#   - HuggingFace:     add GOOGLE_API_KEY under Space Settings -> Repository secrets
#   - Docker / local:  use a .env file (see below)
# =============================================================================

# REQUIRED: Your Google Gemini API key.
# Get one at: https://aistudio.google.com/app/apikey
# This is the ONLY place the key is read from (os.environ.get("GOOGLE_API_KEY")).
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Vercel deployment
# -----------------------------------------------------------------------------
# On Vercel, do NOT set GEMINI_SERVICE_URL. The Next.js chatbot route calls
# the Vercel Python serverless function at /api/gemini automatically.
# Just add GOOGLE_API_KEY in Vercel Project Settings -> Environment Variables.

# -----------------------------------------------------------------------------
# Docker / HuggingFace Spaces deployment
# -----------------------------------------------------------------------------
# OPTIONAL: Override the Python Flask service URL.
# In Docker / HuggingFace Spaces this is set automatically by start.sh.
# GEMINI_SERVICE_URL=http://localhost:8000

# OPTIONAL: Override the Python service port (defaults to 8000).
# GEMINI_SERVICE_PORT=8000

# OPTIONAL: Override the Gemini model (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash
