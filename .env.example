# =============================================================================
# Environment variables for Leo404 + Gemini integration
# =============================================================================
# Copy this file to `.env` for local development. NEVER commit `.env`.
#
# On HuggingFace Spaces: add GOOGLE_API_KEY under Settings -> Secrets.
# =============================================================================

# REQUIRED: Your Google Gemini API key.
# Get one at: https://aistudio.google.com/app/apikey
# This is the ONLY place the key is read from (os.environ.get("GOOGLE_API_KEY")).
GOOGLE_API_KEY=

# OPTIONAL: Override the Gemini model (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL: Override the Python service URL (defaults to http://localhost:8000).
# In Docker / HuggingFace Spaces this is set automatically by start.sh.
# GEMINI_SERVICE_URL=http://localhost:8000

# OPTIONAL: Override the Python service port (defaults to 8000).
# GEMINI_SERVICE_PORT=8000

# ---------------------------------------------------------------------------
# GEMINI TRANSPORT (auto-selected by app/api/chatbot/route.ts)
#
#   GEMINI_SERVICE_URL set  -> use the Python Flask service (gemini/app.py)
#                              [local dev, Docker, HuggingFace Spaces]
#   GEMINI_SERVICE_URL unset + GOOGLE_API_KEY set
#                           -> call the Gemini REST API directly from the
#                              Next.js server route  [VERCEL — one deploy]
# ---------------------------------------------------------------------------
# GEMINI_SERVICE_URL=http://localhost:8000
# GEMINI_MODEL=gemini-3.5-flash-lite
